{
  "name": "video-for-lazies-reporting",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "wrangler dev --local",
    "test": "node --test test/*.test.js",
    "test:runtime": "node test/runtime.mjs",
    "check": "node --check src/worker.js && node --check public/form.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": { "wrangler": "4.151.1" }
}
